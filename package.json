{
  "name": "bibelmap",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-maplibre-worker.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-maplibre-worker.mjs",
    "build": "tsc --noEmit && vite build",
    "check": "node scripts/check-all.mjs",
    "check:aliases": "node scripts/check-aliases.mjs",
    "check:bp": "node scripts/check-bp-guides.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:gospel": "node --experimental-strip-types --import ./scripts/lib/ts-loader.mjs scripts/check-gospel.mjs",
    "check:israel": "node --experimental-strip-types --import ./scripts/lib/ts-loader.mjs scripts/check-israel.mjs",
    "check:links": "node scripts/check-support-links.mjs",
    "check:sources": "node --experimental-strip-types --import ./scripts/lib/ts-loader.mjs scripts/check-sources.mjs",
    "check:tribes": "node --experimental-strip-types --import ./scripts/lib/ts-loader.mjs scripts/check-tribes.mjs",
    "preview": "vite preview",
    "data": "node scripts/build-data.mjs",
    "text": "node scripts/build-text.mjs",
    "names": "node scripts/build-names-de.mjs",
    "media": "node scripts/build-media.mjs",
    "xrefs": "node scripts/build-xrefs.mjs",
    "check:quiz": "node --experimental-strip-types --import ./scripts/lib/ts-loader.mjs scripts/check-quiz.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "leaflet.markercluster": "^1.5.3",
    "maplibre-gl": "^6.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
