{
  "name": "bibelmap",
  "private": true,
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-maplibre-worker.mjs && node --experimental-strip-types --import ./scripts/lib/ts-loader.mjs scripts/build-counts.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-maplibre-worker.mjs && node --experimental-strip-types --import ./scripts/lib/ts-loader.mjs scripts/build-counts.mjs",
    "build": "tsc --noEmit && vite build",
    "check": "node scripts/check-all.mjs",
    "check:aliases": "node scripts/check-aliases.mjs",
    "check:church": "node --experimental-strip-types --import ./scripts/lib/ts-loader.mjs scripts/check-church.mjs",
    "check:bp": "node scripts/check-bp-guides.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:gospel": "node --experimental-strip-types --import ./scripts/lib/ts-loader.mjs scripts/check-gospel.mjs",
    "check:gospel-links": "node --experimental-strip-types --import ./scripts/lib/ts-loader.mjs scripts/check-gospel-links.mjs",
    "check:israel": "node --experimental-strip-types --import ./scripts/lib/ts-loader.mjs scripts/check-israel.mjs",
    "check:links": "node scripts/check-support-links.mjs",
    "check:sources": "node --experimental-strip-types --import ./scripts/lib/ts-loader.mjs scripts/check-sources.mjs",
    "check:tiles": "node scripts/check-tiles.mjs",
    "check:tribes": "node --experimental-strip-types --import ./scripts/lib/ts-loader.mjs scripts/check-tribes.mjs",
    "check:urls": "node scripts/check-urls.mjs",
    "preview": "vite preview",
    "data": "node scripts/build-data.mjs && node --experimental-strip-types --import ./scripts/lib/ts-loader.mjs scripts/build-places-compact.mjs",
    "text": "node scripts/build-text.mjs",
    "names": "node scripts/build-names-de.mjs",
    "media": "node --experimental-strip-types --import ./scripts/lib/ts-loader.mjs scripts/build-media.mjs",
    "xrefs": "node scripts/build-xrefs.mjs",
    "check:quiz": "node --experimental-strip-types --import ./scripts/lib/ts-loader.mjs scripts/check-quiz.mjs",
    "check:history": "node --experimental-strip-types --import ./scripts/lib/ts-loader.mjs scripts/check-history.mjs",
    "check:nations": "node --experimental-strip-types --import ./scripts/lib/ts-loader.mjs scripts/check-nations.mjs",
    "check:genealogy": "node --experimental-strip-types --import ./scripts/lib/ts-loader.mjs scripts/check-genealogy.mjs",
    "check:compare": "node --experimental-strip-types --import ./scripts/lib/ts-loader.mjs scripts/check-compare.mjs",
    "check:passages": "node --experimental-strip-types --import ./scripts/lib/ts-loader.mjs scripts/check-passages.mjs",
    "check:journeys": "node --experimental-strip-types --import ./scripts/lib/ts-loader.mjs scripts/check-journeys.mjs",
    "counts": "node --experimental-strip-types --import ./scripts/lib/ts-loader.mjs scripts/build-counts.mjs",
    "data:compact": "node --experimental-strip-types --import ./scripts/lib/ts-loader.mjs scripts/build-places-compact.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "postbuild": "node scripts/check-budget.mjs",
    "check:offline": "node scripts/check-offline.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "leaflet.markercluster": "^1.5.3",
    "maplibre-gl": "^6.6.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
